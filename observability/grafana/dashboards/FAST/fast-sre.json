    {
      "type": "stat",
      "title": "Sonuca ulaşan istek (SLO ≥ %99,9)",
      "description": "Eşleşen / (eşleşen + 10 dk içinde sonucu gelmeyen). Teknik başarı ölçüsü.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A",
          "expr": "round(sum (increase(reconciler_transfers_total{impl=\"flink\", flow=\"fast\", role=\"sender\"}[$__range]))) / clamp_min(round(sum (increase(reconciler_transfers_total{impl=\"flink\", flow=\"fast\", role=\"sender\"}[$__range]))) + (sum(increase(reconciler_unmatched_total{impl=\"flink\", flow=\"fast\", kind=\"send_without_outcome\"}[$__range])) or vector(0)), 1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 3
