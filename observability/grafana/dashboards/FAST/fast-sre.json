      "title": "Giriş / çıkış kaydı / s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A",
          "expr": "sum(flink_taskmanager_job_task_numRecordsInPerSecond{flow=\"fast\", task_name=~\"Source.*\"})",
          "legendFormat": "Kafka'dan okunan",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "B",
          "expr": "sum(rate(flink_taskmanager_job_task_operator_numRecordsSend{flow=\"fast\"}[$__rate_interval]))",
          "legendFormat": "Kafka'ya yazılan",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
