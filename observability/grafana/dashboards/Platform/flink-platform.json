    {
      "type": "stat",
      "title": "JobManager",
      "description": "UI ve job yönetimi; düşerse tüm job'lar durur, flink-job-supervisor geri gelince yeniden başlatır.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A",
          "expr": "min(up{job=\"flink-jobmanager\"}) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
