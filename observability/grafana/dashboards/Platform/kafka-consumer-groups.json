      "type": "row",
      "title": "Broker",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Brokers",
      "datasource": {
        "type": "prometheus",
