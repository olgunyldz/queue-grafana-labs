        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A",
          "expr": "sum by (endpoint) (rate(producer_http_requests_total{job=\"mock-producer\", endpoint=~\"/events/eft/.*\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
